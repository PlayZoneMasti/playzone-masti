

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PlayZone Masti - Snake Game</title>
<style>
*{box-sizing:border-box}
body{
margin:0;
font-family:Arial,sans-serif;
background:linear-gradient(135deg,#10172a,#172554);
color:white;text-align:center;
padding:20px;
}
h1{color:#38f5a5;margin-bottom:5px}
p{color:#cbd5e1}
.game{
max-width:420px;margin:20px auto;
background:#1e293b;padding:15px;
border-radius:18px;
box-shadow:0 8px 30px #0006;
}
canvas{
width:100%;max-width:360px;
background:#071426;
border:3px solid #38f5a5;
border-radius:8px;
}
.score{font-size:22px;margin:12px}
button{
border:0;border-radius:10px;
padding:12px 20px;
margin:5px;background:#38f5a5;
color:#102033;font-weight:bold;
font-size:16px;cursor:pointer;
}
.controls{margin-top:12px}
.controls button{width:65px;height:50px}
footer{margin-top:25px;color:#94a3b8}
</style>
</head>
<body>
<h1>🎮 PlayZone Masti</h1>
<p>Enjoy Free Online Games!</p>
<div class="game">
<h2>🐍 Snake Game</h2>
<div class="score">Score: <span id="score">0</span></div>
<canvas id="game" width="360" height="360"></canvas>
<br>
<button onclick="startGame()">Start / Restart</button>
<div class="controls">
<div><button onclick="change(0,-1)">⬆️</button></div>
<div>
<button onclick="change(-1,0)">⬅️</button>
<button onclick="change(0,1)">⬇️</button>
<button onclick="change(1,0)">➡️</button>
</div>
</div>
<p id="message">Press Start to Play!</p>
</div>
<footer>© 2026 PlayZone Masti | All Rights Reserved</footer>
<script>
const canvas=document.getElementById("game");
const ctx=canvas.getContext("2d");
const size=18;
let snake,food,dx,dy,score,timer,playing=false;
function startGame(){
clearInterval(timer);
snake=[{x:9,y:9},{x:8,y:9},{x:7,y:9}];
dx=1;dy=0;score=0;
document.getElementById("score").textContent=score;
document.getElementById("message").textContent="Good Luck!";
playing=true;makeFood();draw();
timer=setInterval(update,130);
}
function makeFood(){
food={x:Math.floor(Math.random()*20),y:Math.floor(Math.random()*20)};
if(snake.some(s=>s.x===food.x&&s.y===food.y))makeFood();
}
function change(x,y){
if(!playing)return;
if(x===-dx&&y===-dy)return;
dx=x;dy=y;
}
function update(){
let head={x:snake[0].x+dx,y:snake[0].y+dy};
if(head.x<0||head.x>=20||head.y<0||head.y>=20||
snake.some(s=>s.x===head.x&&s.y===head.y)){
clearInterval(timer);playing=false;
document.getElementById("message").textContent="Game Over! Press Restart.";
return;
}
snake.unshift(head);
if(head.x===food.x&&head.y===food.y){
score+=10;
document.getElementById("score").textContent=score;
makeFood();
}else snake.pop();
draw();
}
function draw(){
ctx.fillStyle="#071426";
ctx.fillRect(0,0,360,360);
ctx.fillStyle="#ff5252";
ctx.beginPath();
ctx.arc(food.x*18+9,food.y*18+9,8,0,Math.PI*2);
ctx.fill();
snake.forEach((s,i)=>{
ctx.fillStyle=i===0?"#38f5a5":"#16a36b";
ctx.fillRect(s.x*18+1,s.y*18+1,16,16);
});
}
document.addEventListener("keydown",e=>{
const keys={
ArrowUp:[0,-1],ArrowDown:[0,1],
ArrowLeft:[-1,0],ArrowRight:[1,0],
w:[0,-1],s:[0,1],a:[-1,0],d:[1,0]
};
if(keys[e.key]){
e.preventDefault();
change(...keys[e.key]);
}
});
draw();
</script>
</body>
</html>
